/* Career (D50, CareerOverlay.cs), "Night Meet" (D55): the goal is a paper kippu top left (UI/NightMeet.cs Ticket),
   an unlock is a NEW ticket with a red stamp. Motion short and directed: the card slides in from the left, the
   check turns pink, the stamp presses in. */
.jm-career { transition-property: opacity; transition-duration: 0.25s; }
.jm-career--away { opacity: 0; }

.jm-career__card { position: absolute; left: 24px; top: 24px; width: 360px; padding: 12px 22px 12px 22px;
    opacity: 1; translate: 0 0;
    transition-property: opacity, translate; transition-duration: 0.28s; transition-timing-function: ease-out-cubic; }
.jm-career__card--out { opacity: 0; translate: -24px 0; transition-duration: 0s; }

.jm-career__head { flex-direction: row; justify-content: space-between; align-items: center; }
.jm-career__kicker, .jm-career__count { font-size: 11px; letter-spacing: 2px; color: var(--momo);
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal; }
.jm-career__count { color: rgba(23, 18, 31, 0.55); letter-spacing: 1px; }

.jm-career__row { flex-direction: row; align-items: center; margin-top: 4px; }
.jm-career__check { width: 22px; height: 22px; border-radius: 11px; border-width: 2px; border-color: rgba(23, 18, 31, 0.4);
    margin-right: 10px; align-items: center; justify-content: center; flex-shrink: 0;
    transition-property: background-color, border-color, scale; transition-duration: 0.22s; }
.jm-career__tick { opacity: 0; }
.jm-career__card--done .jm-career__check { background-color: var(--momo); border-color: var(--momo); }
.jm-career__card--done .jm-career__tick { opacity: 1; }
.jm-career__title { flex-grow: 1; flex-shrink: 1; font-size: 22px; color: var(--sumi); white-space: normal;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-career__reward { font-size: 18px; color: var(--sumi); margin-left: 8px; flex-shrink: 0;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal;
    transition-property: scale, color; transition-duration: 0.22s; }
.jm-career__card--done .jm-career__reward { color: var(--momo); }
.jm-career__hint { font-size: 13px; color: rgba(23, 18, 31, 0.68); margin-top: 2px; margin-left: 32px; white-space: normal; }

.jm-career__meter { height: 4px; margin: 14px 0 0 32px; border-radius: 2px; background-color: rgba(23, 18, 31, 0.14); overflow: hidden; }
.jm-career__fill { height: 100%; width: 0; background-color: var(--momo); border-radius: 2px;
    transition-property: width, background-color; transition-duration: 0.18s; }

.jm-career__dots { flex-direction: row; margin: 8px 0 0 32px; }
.jm-career__dot { width: 18px; height: 4px; margin-right: 5px; border-radius: 2px; background-color: rgba(23, 18, 31, 0.18);
    transition-property: background-color; transition-duration: 0.3s; }
.jm-career__dot--now { background-color: var(--sumi); }
.jm-career__dot--done { background-color: var(--momo); }

/* The NEW ticket: right, under the Sparks balance and its "Saved" line (at 168 px it covered both, UI audit
   2026-10-21) — the middle belongs to the drift score and the notices. A red 新 stamp is pressed onto it. */
.jm-career__banner { position: absolute; right: 24px; top: 204px; width: 400px; padding: 16px 26px 16px 26px;
    opacity: 0; scale: 0.9 0.9; transition-property: opacity, scale; transition-duration: 0.26s; transition-timing-function: ease-out-back; }
.jm-career__banner--on { opacity: 1; scale: 1 1; }
.jm-career__banner-edge { display: none; }
.jm-career__banner-stamp { position: absolute; right: 18px; top: 12px; }
.jm-career__banner-head { flex-direction: row; align-items: center; }
.jm-career__banner-icon { width: 22px; height: 22px; margin-right: 8px; }
.jm-career__banner-kicker { font-size: 12px; letter-spacing: 4px; color: var(--momo);
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal; }
.jm-career__banner-title { font-size: 42px; color: var(--sumi); margin-top: 2px; margin-right: 64px; white-space: normal;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-career__banner-body { font-size: 14px; color: rgba(23, 18, 31, 0.68); white-space: normal; margin-right: 50px; }

/* Phones: a smaller card beside / under the minimap, a narrower banner. */
.jm-phone .jm-career__card { padding: 8px 10px 8px 10px; }
.jm-phone .jm-career__title { font-size: 16px; }
.jm-phone .jm-career__hint { font-size: 12px; margin-left: 30px; }
.jm-phone .jm-career__kicker, .jm-phone .jm-career__count { font-size: 10px; letter-spacing: 2px; }
.jm-phone .jm-career__reward { font-size: 14px; }
.jm-phone .jm-career__banner { right: auto; left: 12px; top: 150px; width: 300px; padding: 10px 14px 12px 14px; }
.jm-phone .jm-career__banner-title { font-size: 26px; }
.jm-phone .jm-career__banner-stamp { width: 40px; height: 40px; }
.jm-phone .jm-career__banner-body { font-size: 12px; }
.jm-portrait .jm-career__banner { left: 50%; margin-left: -150px; top: 46%; }
/* Phones: while a drift chain runs the card steps back (the score in the middle is the moment). */
.jm-career__card--quiet { opacity: 0.3; }

