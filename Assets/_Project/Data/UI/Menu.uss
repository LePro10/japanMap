/* Pause menu "Night Meet" (D55). FH-style: a top bar (Q · tabs with their kana and a pink slant under the open one · E ·
   Sparks · Resume), the page on the left over night fading out to the right where the car turns (MenuCamera),
   big picture tiles, the page's word as giant outlined katakana behind it, a key legend bottom right.
   Imported by Game.uss; rules are scoped under .jm-menu so they win over the generic ones. */

.jm-grow { flex-grow: 1; }
.jm-phone .jm-keyhint, .jm-phone .nm-key.jm-tabkey { display: none; }
.jm-lock-icon { position: absolute; left: 9px; top: 50%; translate: 0 -50%; }
/* A wrapping row wraps its buttons, never squeezes them (a squeezed label broke one letter per line, 2026-10-21). */
.jm-wrap > .jm-btn { flex-shrink: 0; white-space: nowrap; }

/* ── shell ──────────────────────────────────────────────────────────────────────────────────────────────── */
.jm-menu { background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill; opacity: 0; transition: opacity 0.2s ease-out-cubic; }
.jm-menu.jm-menu--in { opacity: 1; }
.jm-menu .jm-shell { flex-direction: row; flex-grow: 1; }
.jm-menu .jm-tabs { flex-direction: column; }
.jm-menu .jm-content { flex-grow: 1; }
.jm-menu .jm-pagewrap { flex-grow: 1; transition: translate 0.24s ease-out-cubic, opacity 0.2s ease-out-cubic; }
.jm-menu .jm-pagewrap > ScrollView { flex-grow: 1; }
.jm-menu .jm-page--from-right { translate: 60px 0; opacity: 0; transition-duration: 0s; }
.jm-menu .jm-page--from-left { translate: -60px 0; opacity: 0; transition-duration: 0s; }
.jm-menu .jm-page--from-below { translate: 0 26px; opacity: 0; transition-duration: 0s; }
.jm-menu.jm-calm .jm-pagewrap { transition-duration: 0s; }

/* The page's giant word, behind everything, nudged in when the tab changes. */
.jm-menu .nm-superword { left: -24px; top: 90px; transition: translate 0.5s ease-out-cubic, opacity 0.4s ease-out-cubic; }
.jm-menu .nm-superword--from-right { translate: 80px 0; opacity: 0; transition-duration: 0s; }
.jm-menu .nm-superword--from-left { translate: -80px 0; opacity: 0; transition-duration: 0s; }
.jm-menu.jm-page--wide .nm-superword { display: none; }

/* ── tabs ───────────────────────────────────────────────────────────────────────────────────────────────── */
.jm-menu .jm-tab {
    align-items: flex-start; justify-content: center; background-color: rgba(0, 0, 0, 0);
    border-width: 0; border-radius: 0; margin: 0; padding: 0;
}
.jm-menu .jm-tab > Label { color: rgba(245, 239, 228, 0.5); font-size: 24px; letter-spacing: 1px; margin: 0;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; transition: color 0.15s ease-out-cubic; }
.jm-menu .jm-tab > .jm-tab__kana { font-size: 11px; letter-spacing: 2px; color: rgba(245, 239, 228, 0.4); margin-bottom: 2px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Dela Gothic JP SDF.asset"); }
/* No runtime-theme box on a hovered or focused tab: the label and the slant say it. */
.jm-menu .jm-tab:hover, .jm-menu .jm-tab:focus, .jm-menu .jm-tab:active, .jm-menu .jm-tab:hover:enabled { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.jm-menu .jm-tab:hover > Label { color: var(--washi); }
.jm-menu .jm-tab:focus > Label { color: var(--washi); }
.jm-menu .jm-tab--on > Label { color: #ffffff; }
.jm-menu .jm-tab--on > .jm-tab__kana { color: var(--momo); }
.jm-menu .jm-tab > UiIcon { opacity: 0.55; }
.jm-menu .jm-tab--on > UiIcon { opacity: 1; }
.jm-menu .jm-tab__new { position: absolute; right: 8px; top: 18px; width: 10px; height: 10px; border-radius: 5px;
    background-color: var(--momo); border-width: 2px; border-color: var(--yoru); }
.jm-menu .jm-continue { min-width: 150px; min-height: 46px; font-size: 18px; margin: 0 0 0 14px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; border-color: rgba(245, 239, 228, 0.5); }
.jm-menu .jm-continue:focus { border-color: var(--washi); background-color: rgba(245, 239, 228, 0.12); }

/* ── desktop top bar ────────────────────────────────────────────────────────────────────────────────────── */
.jm-menu.jm-desktop .jm-shell { flex-direction: column; }
.jm-menu.jm-desktop .jm-rail { height: 92px; flex-direction: row; align-items: center; padding: 0 34px 0 40px; }
.jm-menu .jm-tabrow { flex-direction: row; align-items: center; height: 100%; }
.jm-menu .nm-key.jm-tabkey { margin: 0 4px; }
.jm-menu .jm-tabtrack { flex-direction: row; height: 100%; margin: 0 18px; }
.jm-menu.jm-desktop .jm-tabs { flex-direction: row; height: 100%; }
.jm-menu.jm-desktop .jm-tab { flex-direction: column; height: 100%; padding: 0 18px; }
.jm-menu .jm-tabmarker { position: absolute; bottom: 16px; left: 0; width: 0; height: 5px;
    transition: left 0.22s ease-out-cubic, width 0.22s ease-out-cubic; }
.jm-menu.jm-calm .jm-tabmarker { transition-duration: 0s; }
.jm-menu .jm-sparkchip { flex-direction: row; align-items: center; margin-right: 4px; }
.jm-menu .jm-sparks { font-size: 26px; color: var(--washi); margin: 0 0 0 8px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-menu.jm-desktop .jm-content { flex-grow: 0; }
.jm-menu.jm-desktop.jm-page--narrow .jm-content { width: 47%; min-width: 620px; max-width: 900px; margin: 8px 0 64px 40px; }
.jm-menu.jm-desktop.jm-page--wide .jm-content { flex-grow: 1; margin: 8px 32px 64px 32px; }
.jm-menu .jm-legend { position: absolute; right: 34px; bottom: 22px; flex-direction: row; align-items: center; }
.jm-menu--title .jm-tabrow, .jm-menu--title .jm-sparkchip, .jm-menu--title .jm-tabs { display: none; }

/* A short paper line over the menu (locked, no ad). */
.jm-menu .jm-notice {
    position: absolute; top: 104px; left: 50%; translate: -50% -8px; opacity: 0; padding: 9px 18px; border-radius: 6px;
    background-color: var(--washi); color: var(--sumi); font-size: 16px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal;
    transition: opacity 0.18s ease-out-cubic, translate 0.18s ease-out-cubic;
}
.jm-menu .jm-notice--on { opacity: 1; translate: -50% 0; }

/* The page's aside: fixed at the right over the car (CarsScreen detail, MapScreen ticket). */
.jm-menu .nm-aside { position: absolute; right: 40px; bottom: 74px; width: 520px; }
.jm-menu.jm-phone .nm-aside { right: 10px; bottom: 10px; width: 46%; }
.jm-menu.jm-portrait .nm-aside { position: relative; right: auto; bottom: auto; width: auto; margin: 0 12px; }

/* The car's name over the car (Play, Garage). */
.jm-menu .nm-carname { position: absolute; right: 48px; bottom: 76px; align-items: flex-end; }
.jm-menu .nm-carname__name { font-size: 64px; color: #ffffff; text-shadow: 5px 5px 0 var(--sumi); -unity-text-align: middle-right;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-menu .nm-carname__sub { font-size: 14px; letter-spacing: 3px; color: var(--washi); -unity-text-align: middle-right;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.9); }
.jm-menu.jm-phone .nm-carname { display: none; }

/* Page header */
.jm-menu .jm-pagehead { margin-bottom: 14px; }
.jm-menu .jm-display { font-size: 60px; color: var(--washi); text-shadow: 4px 4px 0 var(--momo); }
.jm-menu .jm-lede { font-size: 22px; color: var(--washi); }
.jm-menu .jm-pagefoot { margin-top: 6px; color: var(--washi-dim); }
.jm-menu .nm-quiet { background-color: rgba(0, 0, 0, 0); border-color: rgba(245, 239, 228, 0.2); color: var(--washi-dim); font-size: 14px; margin-top: 6px; align-self: flex-start; }

/* ── tiles (MenuTiles.Tile): picture, ink from the foot, kicker, big title, one value ────────────────────── */
.jm-menu .nm-tiles { flex-direction: column; }
/* Every tile keeps 12 px on its right; the row gives the last one's back (USS has no :last-child). */
.jm-menu .nm-tilerow { flex-direction: row; margin-bottom: 12px; margin-right: -12px; }
.jm-menu .nm-tilerow--top { margin-bottom: 12px; }
.jm-menu .jm-card {
    flex-grow: 1; flex-basis: 0; height: 168px; margin: 0 12px 0 0; padding: 16px 18px 16px 18px; border-radius: 10px;
    border-width: 3px; border-color: rgba(0, 0, 0, 0); background-color: var(--yoru-2);
    flex-direction: column; align-items: stretch; justify-content: flex-start; -unity-text-align: upper-left; white-space: normal; overflow: hidden;
    transition: scale 0.14s ease-out-cubic, translate 0.26s ease-out-cubic, opacity 0.26s ease-out-cubic, border-color 0.12s ease-out-cubic;
}
.jm-menu .nm-tilerow--top > .jm-card { height: 206px; }
.jm-menu .nm-tile--wide { flex-grow: 2; }
.jm-menu .jm-card:hover:enabled, .jm-menu .jm-card:focus { scale: 1.03 1.03; border-color: var(--washi); }
.jm-menu .jm-card:active:enabled { scale: 0.99 0.99; }
.jm-menu .nm-tile__pic { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.jm-menu .nm-tile__fade { position: absolute; left: 0; right: 0; bottom: 0; height: 80%; -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(18, 14, 30, 0.95); }
.jm-menu .jm-card__head { flex-direction: row; align-items: center; }
.jm-menu .jm-card__icon { margin-right: 8px; }
.jm-menu .jm-card Label { -unity-text-align: upper-left; white-space: normal; }
.jm-menu .jm-card--pic .jm-card__kicker, .jm-menu .jm-card--pic .jm-card__jp { text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95); }
.jm-menu .jm-card--pic .jm-card__kicker { color: #ffffff; }
.jm-menu .jm-card__kicker { font-size: 11px; letter-spacing: 2px; color: var(--momo); margin-right: 8px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal; }
.jm-menu .jm-card__jp { font-size: 11px; color: rgba(245, 239, 228, 0.65); }
.jm-menu .jm-card__title { font-size: 28px; color: #ffffff; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-menu .jm-card__body { font-size: 14px; color: var(--washi-dim); margin-top: 2px; }
.jm-menu .jm-card__value { font-size: 18px; color: var(--washi); margin-top: 4px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Title SDF.asset"); -unity-font-style: normal; }
.jm-menu .jm-card__note { font-size: 13px; color: var(--washi-dim); margin-top: 2px; }
.jm-menu .jm-card__meter { height: 5px; border-radius: 3px; margin-top: 10px; background-color: rgba(245, 239, 228, 0.2); overflow: hidden; }
.jm-menu .jm-card__meter > VisualElement { height: 100%; background-color: var(--momo); }

/* The main tile (Resume): momo, the focus starts there. */
.jm-menu .nm-tile--main { background-color: var(--momo); flex-grow: 1.1; }
.jm-menu .nm-tile--main > .nm-tile__fade { display: none; }
.jm-menu .nm-tile--main .jm-card__kicker, .jm-menu .nm-tile--main .jm-card__jp { color: #ffffff; }
.jm-menu .nm-tile--main .jm-card__title { font-size: 52px; text-shadow: 4px 4px 0 #a8114a; }
.jm-menu .nm-tile--main .jm-card__value { font-size: 14px; letter-spacing: 2px; color: rgba(255, 255, 255, 0.85);
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); }
/* Paper tile (career goal, event in progress): ink on washi, a red stamp in the corner. */
.jm-menu .nm-tile--paper { background-color: var(--washi); }
.jm-menu .nm-tile--paper > .nm-tile__fade { display: none; }
.jm-menu .nm-tile--paper .jm-card__title { color: var(--sumi); text-shadow: none; font-size: 32px; }
.jm-menu .nm-tile--paper .jm-card__jp { color: rgba(23, 18, 31, 0.55); }
.jm-menu .nm-tile--paper .jm-card__value { color: var(--sumi); }
.jm-menu .nm-tile--paper .jm-card__meter { background-color: rgba(23, 18, 31, 0.15); }
.jm-menu .nm-tile--paper:hover:enabled, .jm-menu .nm-tile--paper:focus { border-color: var(--momo); }
.jm-menu .nm-tile__stamp { position: absolute; right: 16px; top: 14px; }

/* Entrance and refusal */
.jm-menu .jm-rise--pre { opacity: 0; translate: 0 18px; transition-duration: 0s; }
.jm-menu .jm-shake { translate: 8px 0; transition-duration: 0.06s; }
.jm-menu .jm-lock { flex-direction: row; align-items: center; align-self: flex-start; margin-top: 8px; padding: 3px 10px 3px 8px; border-radius: 12px; background-color: rgba(0, 0, 0, 0.5); }
.jm-menu .jm-lock__label { font-size: 12px; letter-spacing: 1px; color: var(--washi); margin-left: 6px; }

/* The career goal over other pages (GameMenu.CareerChip): a small paper strip. */
.jm-menu .jm-career-chip { flex-direction: row; align-items: center; align-self: flex-start; background-color: var(--washi); border-radius: 6px;
    padding: 6px 14px; margin-bottom: 12px; }
.jm-menu .jm-career-chip__kicker { font-size: 11px; letter-spacing: 2px; color: var(--momo); margin-right: 10px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal; }
.jm-menu .jm-career-chip__goal { font-size: 16px; color: var(--sumi); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Title SDF.asset"); -unity-font-style: normal; }
.jm-menu .jm-career-chip__reward { font-size: 14px; color: var(--sumi); margin-left: 10px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }

/* ── phone, both orientations ───────────────────────────────────────────────────────────────────────────── */
.jm-menu.jm-phone .jm-rail { background-color: rgba(18, 14, 30, 0.94); }
.jm-menu.jm-phone .jm-display { font-size: 32px; }
.jm-menu.jm-phone .jm-card { height: 112px; padding: 10px 12px; margin-right: 8px; border-radius: 8px; }
.jm-menu.jm-phone .nm-tilerow { margin-right: -8px; }
.jm-menu.jm-phone .nm-tilerow { margin-bottom: 8px; }
.jm-menu.jm-phone .nm-tilerow--top > .jm-card { height: 128px; }
.jm-menu.jm-phone .jm-card__title { font-size: 19px; }
.jm-menu.jm-phone .nm-tile--main .jm-card__title { font-size: 32px; }
.jm-menu.jm-phone .nm-tile--paper .jm-card__title { font-size: 20px; }
.jm-menu.jm-phone .jm-card__kicker, .jm-menu.jm-phone .jm-card__jp { font-size: 10px; }
.jm-menu.jm-phone .jm-card__value { font-size: 14px; }
.jm-menu.jm-phone .jm-card__body, .jm-menu.jm-phone .jm-card__note { display: none; }
.jm-menu.jm-phone .nm-tile__stamp { width: 36px; height: 36px; right: 8px; top: 8px; }
.jm-menu.jm-phone .jm-pagefoot { display: none; }
.jm-menu.jm-phone .jm-continue { -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); background-color: var(--momo); border-color: var(--momo); color: #ffffff; }

/* Phone upright: Resume above a bottom row of icon tabs; the car shows in the top window (MenuCamera lifts it). */
.jm-menu.jm-portrait .jm-shell { flex-direction: column-reverse; }
.jm-menu.jm-portrait .jm-rail { flex-direction: column; padding: 10px 12px 6px 12px; border-top-width: 1px; border-color: var(--line); }
.jm-menu.jm-portrait .jm-tabs { flex-direction: row; }
.jm-menu.jm-portrait .jm-tab { flex-direction: column; align-items: center; flex-grow: 1; flex-basis: 0; min-width: 48px; height: 60px; padding-top: 4px;
    border-top-width: 4px; border-color: rgba(0, 0, 0, 0); }
.jm-menu.jm-portrait .jm-tab--on { border-top-color: var(--momo); }
.jm-menu.jm-portrait .jm-tab > Label { margin: 4px 0 0 0; font-size: 12px; }
.jm-menu.jm-portrait .jm-continue { margin: 0 0 8px 0; min-height: 52px; }
.jm-menu.jm-portrait.jm-page--narrow .jm-content { margin-top: 200px; padding: 0 12px; }
.jm-menu.jm-portrait.jm-page--wide .jm-content { padding: 8px 10px 0 10px; }

/* Phone on its side: a narrow rail on the left, the page in the middle, the car right. */
.jm-menu.jm-landscape .jm-rail { width: 160px; padding: 8px 0; border-right-width: 1px; border-color: var(--line); }
.jm-menu.jm-landscape .jm-tab { flex-direction: row; align-items: center; justify-content: flex-start; height: 42px; padding-left: 14px;
    border-left-width: 4px; border-color: rgba(0, 0, 0, 0); }
.jm-menu.jm-landscape .jm-tab--on { border-left-color: var(--momo); }
.jm-menu.jm-landscape .jm-tab > Label { margin-left: 8px; font-size: 15px; }
.jm-menu.jm-landscape .jm-continue { min-width: 0; min-height: 44px; font-size: 16px; margin: 0 10px 8px 10px; }
.jm-menu.jm-landscape.jm-page--narrow .jm-content { flex-grow: 0; width: 52%; margin: 8px 0 8px 10px; }
.jm-menu.jm-landscape.jm-page--wide .jm-content { margin: 8px 8px 8px 10px; }

/* ── garage (CarsScreen) ────────────────────────────────────────────────────────────────────────────────── */
.jm-menu .nm-chips { margin: 0 0 12px 0; }
.jm-menu .nm-chip { min-height: 38px; padding: 0 14px; border-radius: 19px; font-size: 13px; letter-spacing: 1px; margin: 0 6px 6px 0;
    border-width: 0; background-color: rgba(245, 239, 228, 0.08); color: var(--washi-dim); }
.jm-menu .nm-chip:hover:enabled, .jm-menu .nm-chip:focus { background-color: rgba(245, 239, 228, 0.16); color: var(--washi); }
.jm-menu .nm-chip--on, .jm-menu .nm-chip--on:hover:enabled { background-color: var(--washi); color: var(--sumi); }
.jm-menu .nm-carlist { flex-direction: column; }
.jm-menu .nm-carrow { flex-direction: row; align-items: center; min-height: 76px; margin: 0 0 8px 0; padding: 6px 18px 6px 6px; border-radius: 10px;
    border-width: 3px; border-color: rgba(0, 0, 0, 0); background-color: rgba(30, 24, 48, 0.82); -unity-text-align: middle-left;
    transition: scale 0.12s ease-out-cubic, border-color 0.12s ease-out-cubic; }
.jm-menu .nm-carrow:hover:enabled, .jm-menu .nm-carrow:focus { border-color: rgba(245, 239, 228, 0.6); scale: 1.015 1.015; }
.jm-menu .nm-carrow--on, .jm-menu .nm-carrow--on:hover:enabled { background-color: var(--washi); border-color: var(--momo); }
.jm-menu .nm-carrow__pic { width: 128px; height: 62px; border-radius: 6px; margin-right: 14px; background-color: var(--yoru-3); -unity-background-scale-mode: scale-and-crop; }
.jm-menu .nm-carrow__text { flex-grow: 1; }
.jm-menu .nm-carrow__name { font-size: 22px; color: var(--washi); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-menu .nm-carrow__sub { font-size: 11px; letter-spacing: 2px; color: var(--washi-dim); margin-top: 2px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal; }
.jm-menu .nm-carrow__tag { font-size: 18px; color: var(--washi); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-menu .nm-carrow__tag--driving { color: var(--momo); }
.jm-menu .nm-carrow__tag--owned { color: var(--washi-dim); font-size: 14px; }
.jm-menu .nm-carrow__spark { margin-left: 6px; }
.jm-menu .nm-carrow--on .nm-carrow__name, .jm-menu .nm-carrow--on .nm-carrow__tag { color: var(--sumi); }
.jm-menu .nm-carrow--on .nm-carrow__sub { color: rgba(23, 18, 31, 0.6); }
.jm-menu .nm-carrow--on .nm-carrow__tag--driving { color: var(--momo); }
.jm-menu.jm-phone .nm-carrow { min-height: 58px; }
.jm-menu.jm-phone .nm-carrow__pic { width: 84px; height: 44px; }
.jm-menu.jm-phone .nm-carrow__name { font-size: 16px; }

.jm-menu .nm-cardetail { padding: 18px 20px 14px 20px; border-radius: 10px; }
.jm-menu .nm-cardetail__head { flex-direction: row; align-items: flex-start; }
.jm-menu .nm-cardetail__name { font-size: 44px; color: var(--sumi); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-menu .nm-cardetail__sub { font-size: 13px; color: rgba(23, 18, 31, 0.62); white-space: normal; margin-top: 2px; }
.jm-menu .nm-cardetail__pic { height: 150px; border-radius: 6px; margin-top: 12px; -unity-background-scale-mode: scale-and-crop; background-color: var(--yoru-2); }
.jm-menu .nm-cardetail__stats { margin: 14px 0 12px 0; }
.jm-menu .nm-statrow { flex-direction: row; align-items: center; height: 26px; }
.jm-menu .nm-statrow__name { width: 108px; font-size: 13px; color: rgba(23, 18, 31, 0.7); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal; }
.jm-menu .nm-statrow__track { flex-grow: 1; height: 10px; background-color: rgba(23, 18, 31, 0.1); margin-right: 12px; }
.jm-menu .nm-statrow__fill { position: absolute; left: 0; top: 0; bottom: 0; }
.jm-menu .nm-statrow__value { width: 132px; font-size: 16px; color: var(--sumi); -unity-text-align: middle-right;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal; }
.jm-menu .nm-cardetail__acts { flex-direction: row; flex-wrap: wrap; align-items: center; }
.jm-menu .nm-cardetail .jm-small { color: rgba(23, 18, 31, 0.62); }
.jm-menu .nm-btn--ink { border-color: rgba(23, 18, 31, 0.35); color: var(--sumi); background-color: rgba(0, 0, 0, 0); }
.jm-menu .nm-btn--ink:hover:enabled, .jm-menu .nm-btn--ink:focus { border-color: var(--sumi); background-color: rgba(23, 18, 31, 0.06); }
.jm-menu .nm-cardetail .jm-btn--on { background-color: var(--sumi); color: var(--washi); border-color: var(--sumi); opacity: 1; }
.jm-menu .nm-cardetail .jm-btn:disabled { opacity: 0.75; }
.jm-menu .nm-cardetail .jm-btn--primary:disabled { background-color: rgba(23, 18, 31, 0.25); border-color: rgba(23, 18, 31, 0.0); color: var(--sumi); opacity: 1; }
.jm-menu .nm-back { min-height: 40px; margin-right: 14px; }
.jm-menu .nm-pagehead__sub { font-size: 14px; letter-spacing: 3px; color: var(--momo); margin-left: 14px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Label SDF.asset"); -unity-font-style: normal; }

/* ── map page (MapScreen): the map takes the page, chips over it, the selection as a ticket at the right ──── */
.jm-menu .nm-mapstage { border-radius: 12px; overflow: hidden; border-width: 1px; border-color: var(--line); }
.jm-menu .nm-worldmap { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.jm-menu .nm-mapchips { position: absolute; left: 16px; bottom: 12px; }
.jm-menu .nm-mapchips .nm-chip { background-color: rgba(23, 18, 31, 0.86); color: var(--washi); }
.jm-menu .nm-mapchips .nm-chip--on { background-color: var(--washi); color: var(--sumi); }
.jm-menu .nm-compass { position: absolute; right: 16px; top: 16px; width: 48px; height: 48px; border-radius: 24px;
    background-color: rgba(23, 18, 31, 0.86); color: var(--washi); font-size: 20px; -unity-text-align: middle-center;
    border-top-width: 3px; border-color: var(--momo); }
.nm-maplabel { position: absolute; translate: -50% -50%; align-items: center; }
.nm-maplabel__en { font-size: 18px; letter-spacing: 4px; color: var(--washi); -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); -unity-font-style: normal;
    text-shadow: 0 0 6px rgba(0, 0, 0, 1); }
.nm-maplabel__jp { font-size: 11px; letter-spacing: 3px; color: var(--momo); -unity-text-align: middle-center; margin-top: 2px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Dela Gothic JP SDF.asset"); -unity-font-style: normal; text-shadow: 0 0 5px rgba(0, 0, 0, 1); }
.jm-menu .nm-aside .nm-mapcard { width: 420px; align-self: flex-end; }
.jm-menu .nm-mapcard__ticket { padding: 16px 24px 12px 24px; }
.jm-menu .nm-mapcard__ticket .jm-h2 { font-size: 32px; color: var(--sumi); margin-top: 0; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Archivo Display SDF.asset"); }
.jm-menu .nm-mapcard__ticket .jm-body, .jm-menu .nm-mapcard__ticket Label { color: var(--sumi); }
.jm-menu .nm-mapcard__ticket .jm-small { color: rgba(23, 18, 31, 0.65); }
.jm-menu .nm-mapcard__ticket .jm-amber, .jm-menu .nm-mapcard__ticket .jm-sakura { color: var(--momo); }
.jm-menu .nm-mapcard__ticket .jm-btn { border-color: rgba(23, 18, 31, 0.35); color: var(--sumi); }
.jm-menu .nm-mapcard__ticket .jm-btn--primary { color: #ffffff; border-color: var(--momo); }
.jm-menu .nm-mapcard__ticket .jm-pic { border-radius: 6px; }
