@import url("/Assets/_Project/Data/UI/Menu.uss");
@import url("/Assets/_Project/Data/UI/Title.uss");
/* Game UI theme — "blue hour after rain" (legacy src/ui/theme.css, ASTRA §10).
   Dark ink panels, warm white type, amber = money/selection, sakura = discovery, nitro = boost,
   vermilion only for braking/errors. Sizes in CSS px (UiPanel): body ≥ 16, secondary 14, targets ≥ 48. */
:root {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-Medium SDF.asset");
    --ink: #06141a;
    --ink-2: #0a242c;
    --ink-3: #12323b;
    --panel: rgba(10, 36, 44, 0.9);
    --panel-solid: rgb(10, 32, 40);
    --line: rgba(94, 214, 245, 0.22);
    --paper: #f6efe4;
    --paper-dim: #b7c4c8;
    /* 2026-10-17 (owner: "dieser komische braune Look"): the accent is the blue hour's cyan; gold only for Sparks. */
    --amber: #5ed6f5;
    --amber-hot: #8fe6ff;
    --gold: #ffd166;
    --sakura: #e8a9c0;
    --nitro: #66d7f4;
    --vermilion: #c44536;
    --leaf: #8fbf6a;
    --teal: #1a6b76;
}

.jm-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.jm-ignore { }

Label { color: var(--paper); font-size: 16px; }
.jm-h1 { font-size: 28px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; color: var(--paper); margin-bottom: 8px; }
.jm-h2 { font-size: 20px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; color: var(--paper); margin-top: 14px; margin-bottom: 6px; }
.jm-body { font-size: 16px; color: var(--paper); white-space: normal; }
.jm-small { font-size: 14px; color: var(--paper-dim); white-space: normal; }
.jm-dim { color: var(--paper-dim); }
.jm-amber { color: var(--amber-hot); }
.jm-sakura { color: var(--sakura); }
.jm-ok { color: var(--leaf); }
.jm-error { color: #ff8a7a; }
.jm-big { font-size: 40px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; }
.jm-shadow { text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8); }

/* One surface language (2026-10-11): near-opaque dark ink, square-ish corners, hairlines instead of boxes. */
.jm-panel {
    background-color: rgba(7, 15, 20, 0.92);
    border-width: 1px;
    border-color: rgba(246, 239, 228, 0.08);
    border-radius: 4px;
    padding: 18px;
}
.jm-plate {
    background-color: rgba(6, 20, 26, 0.62);
    border-radius: 12px;
    padding: 6px 18px;
}
.jm-row { flex-direction: row; align-items: center; }
.jm-wrap { flex-wrap: wrap; }
.jm-grow { flex-grow: 1; }
.jm-gap > * { margin-right: 8px; margin-bottom: 8px; }

/* Buttons: 48 px minimum, 8 px apart, focus outline, nothing needs hover. */
.jm-btn {
    min-height: 48px;
    min-width: 48px;
    padding: 0 16px;
    margin: 0 8px 8px 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(246, 239, 228, 0.18);
    background-color: rgba(246, 239, 228, 0.06);
    color: var(--paper);
    font-size: 16px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: normal;
}
.jm-btn:hover, .jm-btn:hover:enabled { background-color: rgba(246, 239, 228, 0.13); }
.jm-btn:active, .jm-btn:active:enabled, .jm-btn:hover:active:enabled { background-color: rgba(246, 239, 228, 0.03); }
.jm-btn:focus { border-color: var(--amber-hot); }
.jm-btn:disabled { opacity: 0.45; }
.jm-btn--primary { background-color: var(--amber); color: var(--ink); border-color: var(--amber-hot); min-height: 56px; font-size: 18px; }
.jm-btn--primary:hover, .jm-btn--primary:hover:enabled { background-color: var(--amber-hot); }
.jm-btn--on:hover:enabled { background-color: rgba(94, 214, 245, 0.2); }
.jm-btn--on { border-color: var(--amber-hot); background-color: rgba(94, 214, 245, 0.14); color: var(--amber-hot); }
.jm-btn--danger { background-color: rgba(196, 69, 54, 0.85); }
.jm-btn--wide { flex-grow: 1; }
.jm-btn--swatch { min-width: 48px; width: 48px; height: 48px; padding: 0; border-radius: 24px; }

/* Dark, thin scrollbars (Unity's default is a light grey bar). */
.unity-scroller--vertical { width: 6px; }
.unity-scroller--horizontal { height: 10px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-scroller .unity-base-slider__tracker { background-color: rgba(246, 239, 228, 0.06); border-width: 0; }
.unity-scroller .unity-base-slider__dragger { background-color: rgba(246, 239, 228, 0.22); border-width: 0; border-radius: 5px; }
.unity-scroller .unity-base-slider__dragger-border { display: none; }

.jm-cols { flex-direction: row; flex-grow: 1; }
.jm-phone .jm-cols { flex-direction: column; }
.jm-col { flex-grow: 1; flex-basis: 0; margin-right: 16px; }
.jm-phone .jm-col { margin-right: 0; flex-basis: auto; }

.jm-panel, .jm-part { background-color: rgba(8, 17, 28, 0.88); border-radius: 10px; border-width: 1px; border-color: rgba(255, 255, 255, 0.07); }
.jm-kicker { color: var(--amber); }
.jm-tile {
    background-color: rgba(246, 239, 228, 0.05);
    border-radius: 4px;
    padding: 10px;
    margin: 0 10px 10px 0;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}
.jm-tile:hover:enabled, .jm-tile:active:enabled { background-color: rgba(246, 239, 228, 0.1); }
.jm-tile--on { border-color: var(--amber-hot); }
.jm-pic { background-color: rgb(10, 18, 22); border-radius: 2px; -unity-background-scale-mode: scale-and-crop; }
.jm-chip { background-color: rgba(94, 214, 245, 0.16); border-radius: 12px; padding: 2px 10px; margin-right: 6px; font-size: 14px; color: var(--amber); }

/* Settings rows */
.jm-setting { flex-direction: row; align-items: center; min-height: 52px; border-bottom-width: 1px; border-color: rgba(246, 239, 228, 0.08); }
.jm-setting > Label { width: 220px; }
.jm-phone .jm-setting > Label { width: 110px; }
.jm-phone .jm-setting .unity-slider { min-width: 80px; }
.jm-phone .jm-value { width: 52px; }
.jm-setting .unity-slider { flex-grow: 1; margin-right: 12px; min-width: 120px; }
.jm-setting .unity-base-slider__input { flex-grow: 1; }
.unity-slider .unity-base-slider__tracker { background-color: rgba(246, 239, 228, 0.18); border-width: 0; height: 6px; margin-top: -3px; border-radius: 3px; }
.unity-slider .unity-base-slider__dragger { background-color: var(--amber-hot); border-width: 0; width: 22px; height: 22px; margin-top: -11px; border-radius: 11px; }
.unity-slider .unity-base-slider__dragger-border { display: none; }
.jm-value { width: 64px; -unity-text-align: middle-right; color: var(--amber); }

/* Sheet in the middle of the screen: event card, results, purchase. */
.jm-sheet { align-self: center; max-width: 720px; width: 90%; }
.jm-center { align-items: center; justify-content: center; }

/* Touch controls */
.jm-touch {
    position: absolute;
    border-radius: 999px;
    border-width: 2px;
    border-color: rgba(246, 239, 228, 0.55);
    background-color: rgba(246, 239, 228, 0.14);
    align-items: center;
    justify-content: center;
}
.jm-touch Label { font-size: 13px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; color: var(--paper); -unity-text-align: middle-center; }
.jm-touch--down { background-color: rgba(246, 239, 228, 0.38); }
.jm-touch--drift { background-color: rgba(232, 120, 60, 0.35); }
.jm-touch--brake { background-color: rgba(196, 69, 54, 0.38); }
.jm-touch--boost { background-color: rgba(102, 215, 244, 0.35); }
.jm-touch--on { border-color: var(--amber-hot); background-color: rgba(94, 214, 245, 0.4); }

/* ── Intro "First Drive" (FirstDrive / IntroOverlay; prototype introOverlay.css) ───────────────────────── */
.jm-intro__bar { position: absolute; left: 0; right: 0; height: 0; background-color: rgb(0, 0, 0);
    transition-property: height; transition-duration: 0.6s; transition-timing-function: ease-in-out-sine; }
.jm-intro__bar--top { top: 0; }
.jm-intro__bar--bottom { bottom: 0; }
.jm-intro__bar--on { height: 11%; }
.jm-intro__title { position: absolute; left: 0; right: 0; top: 30%; align-items: center; opacity: 0; translate: 0 12px;
    transition-property: opacity, translate; transition-duration: 0.7s; }
.jm-intro__title--on { opacity: 1; translate: 0 0; }
.jm-intro__kicker { font-size: 13px; letter-spacing: 6px; color: var(--amber); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; }
.jm-intro__name { font-size: 64px; letter-spacing: 14px; color: var(--paper); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.85); margin-top: 4px; }
.jm-intro__sub { font-size: 16px; color: var(--paper-dim); margin-top: 6px; -unity-font-style: italic; }
.jm-intro__prompt { position: absolute; left: 22%; right: 22%; top: 58%; align-items: center; opacity: 0; scale: 0.92 0.92;
    transition-property: opacity, scale; transition-duration: 0.25s; }
.jm-intro__prompt--on { opacity: 1; scale: 1 1; }
.jm-intro__prompt--big { top: 50%; }
.jm-intro__prompt--big .jm-intro__key { font-size: 30px; min-width: 120px; height: 62px; }
.jm-intro__prompt--hit .jm-intro__key { background-color: var(--amber-hot); color: var(--ink); border-color: var(--paper); }
.jm-intro__keys { flex-direction: row; align-items: center; }
.jm-intro__key { font-size: 22px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; color: var(--paper); min-width: 64px; height: 50px; padding: 0 16px;
    -unity-text-align: middle-center; background-color: rgba(6, 20, 26, 0.82); border-width: 2px; border-color: var(--paper);
    border-bottom-width: 5px; border-radius: 10px; transition-property: background-color, color; transition-duration: 0.15s; }
.jm-intro__plus { font-size: 20px; color: var(--paper-dim); margin: 0 8px; }
.jm-intro__label { font-size: 26px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; color: var(--paper); margin-top: 10px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9); }
.jm-intro__hint { font-size: 15px; color: var(--paper-dim); margin-top: 2px; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9); }
.jm-intro__toast { position: absolute; left: 0; right: 0; top: 34%; -unity-text-align: middle-center; font-size: 34px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; color: var(--paper); text-shadow: 0 3px 16px rgba(0, 0, 0, 0.9); display: none; }
.jm-intro__toast--gold { color: var(--amber-hot); }
.jm-intro__slow { position: absolute; left: 0; right: 0; top: 13%; align-items: center; opacity: 0;
    transition-property: opacity; transition-duration: 0.3s; }
.jm-intro__slow--on { opacity: 1; }
.jm-intro__slow Label { font-size: 13px; letter-spacing: 8px; color: var(--nitro); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; }
/* In the top letterbox bar: the bottom belongs to the key overlay, the top-right corner to MENU. */
.jm-intro__steps { position: absolute; left: 32%; right: 32%; top: 3.6%; flex-direction: row; justify-content: center; }
.jm-intro__steps--off { display: none; }
.jm-intro__step { margin: 0 10px; border-top-width: 3px; border-color: rgba(246, 239, 228, 0.25); padding-top: 4px; width: 64px; }
.jm-intro__step Label { font-size: 11px; letter-spacing: 2px; color: rgba(246, 239, 228, 0.45); -unity-text-align: middle-center; }
.jm-intro__step--done { border-color: var(--amber); }
.jm-intro__step--done Label { color: var(--amber); }
.jm-intro__step--now { border-color: var(--paper); }
.jm-intro__step--now Label { color: var(--paper); }
.jm-intro__skip { position: absolute; left: 16px; top: 2.5%; height: 36px; padding: 0 14px; border-radius: 18px;
    background-color: rgba(6, 20, 26, 0.7); border-width: 1px; border-color: rgba(246, 239, 228, 0.35); overflow: hidden; }
.jm-intro__skip Label { font-size: 12px; letter-spacing: 2px; color: var(--paper-dim); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; }
.jm-intro__skipfill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: rgba(94, 214, 245, 0.35); }
/* Phones: no letterbox (it covered the touch controls and the top row), no step row, skip at the top centre. */
.jm-phone .jm-intro__bar--on { height: 0; }
.jm-phone .jm-intro__steps { display: none; }
.jm-phone .jm-intro__skip { left: 50%; translate: -50% 0; top: 8px; }
.jm-portrait .jm-intro__skip { top: auto; bottom: 236px; }
.jm-phone .jm-intro__title { top: 22%; }
.jm-phone .jm-intro__prompt { top: 30%; left: 30%; right: 30%; }
.jm-phone .jm-intro__prompt--big { top: 26%; }
.jm-phone .jm-intro__name { font-size: 40px; letter-spacing: 8px; }
.jm-phone .jm-intro__label { font-size: 20px; }
.jm-phone .jm-intro__toast { font-size: 24px; }

/* World pins (WorldPins.cs): label over a place, stem and dot on the spot. */
.jm-pin { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-origin: 0 0; }
.jm-pin__inner { position: absolute; width: 320px; left: -160px; bottom: -5px; align-items: center; }
.jm-pin__plate {
    background-color: rgba(4, 12, 16, 0.9);
    border-left-width: 3px;
    border-radius: 3px;
    padding: 6px 12px 7px 10px;
    align-items: flex-start;
}
.jm-pin__title { font-size: 15px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; letter-spacing: 2px; color: var(--paper); }
.jm-pin__sub { font-size: 12px; color: var(--paper-dim); margin-right: 8px; }
.jm-pin__dist { font-size: 12px; color: var(--amber); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; }
.jm-pin__stem { width: 2px; height: 26px; opacity: 0.7; }
.jm-pin__dot { width: 10px; height: 10px; border-radius: 5px; }

/* Typography (2026-10-13): Barlow for reading, Saira Condensed for titles, numbers and the letter-spaced caps —
   the default Unity font made every screen look like a tool. Fonts: Art/Fonts (OFL). */
.jm-display, .jm-big, .jm-h1, .jm-card-title, .jm-brand, .jm-kicker, .jm-rail .jm-tab Label, .jm-tab Label,
.jm-pin__title, .jm-lede, .jm-num { -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset"); -unity-font-style: normal; }
.jm-display { font-size: 54px; letter-spacing: 1px; }
.jm-phone .jm-display { font-size: 30px; }
.jm-h1 { font-size: 32px; letter-spacing: 1px; }
.jm-card-title { font-size: 28px; }
.jm-phone .jm-card-title { font-size: 20px; }
.jm-kicker { font-size: 13px; letter-spacing: 3px; }
.jm-phone .jm-kicker { font-size: 11px; letter-spacing: 2px; }
.jm-lede { font-size: 22px; }
.jm-brand { font-size: 24px; letter-spacing: 5px; }
.jm-rail .jm-tab Label { font-size: 17px; letter-spacing: 3px; }
.jm-pin__title { font-size: 17px; letter-spacing: 2px; }


/* HUD text and motion. */
.jm-hud-text { -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; }
.jm-hud-text.jm-num { -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset"); letter-spacing: 1px; }
.jm-anim { transition-property: scale, opacity, translate; transition-duration: 0.22s; transition-timing-function: ease-out-back; }

/* Result hero (GameplayHud.ShowResult). */
.jm-result { flex-direction: row; align-items: center; margin: 8px 0 14px 0; }
.jm-medal {
    width: 96px; height: 96px; border-radius: 48px; border-width: 3px;
    -unity-text-align: middle-center; white-space: normal; font-size: 15px; letter-spacing: 1px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset");
    margin-right: 20px; padding: 6px;
}
.jm-medal--gold { background-color: rgba(143, 230, 255, 0.22); border-color: #f3c56a; color: #f3c56a; }
.jm-medal--silver { background-color: rgba(201, 210, 218, 0.18); border-color: #c9d2da; color: #e3e9ee; }
.jm-medal--bronze { background-color: rgba(201, 139, 91, 0.2); border-color: #c98b5b; color: #e0a578; }
.jm-medal--none { background-color: rgba(246, 239, 228, 0.06); border-color: rgba(246, 239, 228, 0.25); color: var(--paper-dim); }
.jm-result__text { flex-grow: 1; }
.jm-result__main { font-size: 52px; color: var(--paper); -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset"); }
.jm-result__reward { font-size: 28px; color: var(--amber-hot); -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset"); }
.jm-phone .jm-medal { width: 64px; height: 64px; border-radius: 32px; font-size: 11px; margin-right: 12px; }
.jm-phone .jm-result__main { font-size: 32px; }
.jm-phone .jm-result__reward { font-size: 20px; }

/* Garage (CarsScreen Tune / Appearance). */
.jm-perf { padding: 16px 18px 10px 18px; margin-top: 10px; }
.jm-stat { flex-direction: row; align-items: center; height: 26px; }
.jm-stat__name { width: 120px; font-size: 14px; color: var(--paper-dim); }
.jm-stat__track { flex-grow: 1; height: 8px; border-radius: 4px; background-color: rgba(246, 239, 228, 0.1); overflow: hidden; }
.jm-stat__fill, .jm-stat__ghost { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; transition: width 0.18s ease-out; }
.jm-stat__fill { background-color: var(--amber-hot); }
.jm-stat__ghost { background-color: #7fd18b; }
.jm-stat__ghost--down { background-color: #e0675a; }
.jm-stat__value { width: 96px; -unity-text-align: middle-right; font-size: 16px; color: var(--paper); -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset"); }
.jm-stat__value--up { color: #7fd18b; }
.jm-stat__value--down { color: #e0675a; }
.jm-part { background-color: rgba(7, 15, 20, 0.88); border-radius: 4px; padding: 8px 14px 10px 14px; margin-top: 6px; border-left-width: 3px; border-color: rgba(94, 214, 245, 0.5); }
.jm-part__title { font-size: 20px; color: var(--paper); -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset"); margin-right: 10px; }
.jm-seg { flex-direction: row; margin-top: 6px; }
.jm-seg__item {
    flex-grow: 1; flex-basis: 0; min-height: 40px; margin: 0 6px 0 0; border-radius: 3px; border-width: 1px;
    border-color: rgba(246, 239, 228, 0.16); background-color: rgba(246, 239, 228, 0.05); color: var(--paper);
    font-size: 14px; letter-spacing: 1px; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Barlow-SemiBold SDF.asset"); -unity-font-style: normal; -unity-text-align: middle-center;
}
.jm-seg__item:hover:enabled { background-color: rgba(246, 239, 228, 0.12); border-color: rgba(246, 239, 228, 0.35); }
.jm-seg__item--on { background-color: rgba(94, 214, 245, 0.2); border-color: var(--amber-hot); color: var(--amber-hot); }
.jm-seg__item:disabled { opacity: 0.4; }
.jm-seg__item--on:disabled { opacity: 1; background-color: rgba(94, 214, 245, 0.2); color: var(--amber-hot); border-color: var(--amber-hot); }
.jm-phone .jm-stat__name { width: 84px; font-size: 12px; }
.jm-phone .jm-stat__value { width: 70px; font-size: 13px; }
.jm-phone .jm-seg__item { font-size: 12px; min-height: 40px; }

/* Scroll bars: a thin, quiet line (the theme's dragger drew a 14 px amber bar next to every long page). */
.jm-menu .unity-scroller--vertical { width: 6px; min-width: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.jm-menu .unity-scroller--vertical .unity-base-slider__dragger,
.jm-menu .unity-scroller--vertical .unity-slider__dragger { background-color: rgba(246, 239, 228, 0.22); border-width: 0; width: 6px; left: 0; margin-top: 0; border-radius: 3px; }
.jm-menu .unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }

/* ── Menu redesign 2026-10-17 ───────────────────────────────────────────────────────────────────────────────
   Owner: brown, cluttered, no pictures, the menu covers the car. Now: a top bar (brand · tabs · Sparks · Resume),
   one glass column on the left, the car turning in the free right half (MenuCamera frames it there); navy glass,
   white type, cyan accent, gold only for money. */
.jm-amber, .jm-lede, .jm-chip, .jm-value { color: var(--gold); }
.jm-chip { background-color: rgba(255, 209, 102, 0.12); }
.jm-btn { border-radius: 8px; border-color: rgba(255, 255, 255, 0.14); background-color: rgba(255, 255, 255, 0.06); }
.jm-btn:hover, .jm-btn:hover:enabled { background-color: rgba(255, 255, 255, 0.14); border-color: rgba(255, 255, 255, 0.3); }
.jm-btn--primary { background-color: var(--amber); color: #04131c; border-color: var(--amber-hot); }
.jm-btn--primary:hover, .jm-btn--primary:hover:enabled { background-color: var(--amber-hot); }
.jm-btn--on { background-color: rgba(94, 214, 245, 0.16); color: var(--amber-hot); border-color: var(--amber); }
.jm-tile { background-color: rgba(255, 255, 255, 0.05); border-radius: 10px; border-width: 2px; border-color: rgba(255, 255, 255, 0.04); padding: 0; overflow: hidden; }
.jm-tile:hover:enabled { background-color: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.18); }
.jm-tile--on { border-color: var(--amber); background-color: rgba(94, 214, 245, 0.1); }

/* Car cards with a picture (CarPortraits: the car photographed in the Open Bay). */
.jm-cargrid { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.jm-carcard { width: 48%; margin: 0 2% 12px 0; }
.jm-phone .jm-carcard { width: 47%; }
.jm-carpic { height: 128px; background-color: rgb(9, 18, 28); -unity-background-scale-mode: scale-and-crop; }
.jm-phone .jm-carpic { height: 84px; }
.jm-carcard__text { padding: 8px 12px 10px 12px; }
.jm-carcard__name { font-size: 20px; color: var(--paper); -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset"); }
.jm-carcard__tag { font-size: 13px; color: var(--paper-dim); }
.jm-carcard__tag--price { color: var(--gold); }
.jm-carcard__tag--driving { color: var(--amber); }
.jm-hero { height: 200px; border-radius: 10px; margin: 6px 0 12px 0; -unity-background-scale-mode: scale-and-crop; background-color: rgb(9, 18, 28); }
.jm-phone .jm-hero { height: 120px; }
.jm-specs { flex-direction: row; flex-wrap: wrap; margin: 10px 0 4px 0; }
.jm-spec { width: 33%; padding: 6px 10px 8px 0; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.07); }
.jm-phone .jm-spec { width: 50%; }
.jm-spec__name { font-size: 11px; letter-spacing: 2px; color: var(--paper-dim); }
.jm-spec__value { font-size: 19px; color: var(--paper); -unity-font-definition: url("/Assets/_Project/Art/Fonts/SairaCondensed-Bold SDF.asset"); white-space: normal; }
