# Gilt nur für das Unity-Projekt (Assets/, ArtSource/). Der Prototyp unter
# legacy/threejs/ bleibt bewusst unberührt — keine Regel hier greift dort.

# ── Unity-YAML: als Text, LF, mit Unitys Merge-Werkzeug (Treiber: docs/SETUP.md)
Assets/**/*.unity            text eol=lf merge=unityyamlmerge
Assets/**/*.prefab           text eol=lf merge=unityyamlmerge
Assets/**/*.asset            text eol=lf merge=unityyamlmerge
Assets/**/*.mat              text eol=lf merge=unityyamlmerge
Assets/**/*.anim             text eol=lf merge=unityyamlmerge
Assets/**/*.controller       text eol=lf merge=unityyamlmerge
Assets/**/*.overrideController text eol=lf merge=unityyamlmerge
Assets/**/*.physicMaterial   text eol=lf merge=unityyamlmerge
Assets/**/*.mask             text eol=lf merge=unityyamlmerge
Assets/**/*.playable         text eol=lf merge=unityyamlmerge
Assets/**/*.lighting         text eol=lf merge=unityyamlmerge
Assets/**/*.meta             text eol=lf
ProjectSettings/*.asset      text eol=lf merge=unityyamlmerge
Packages/*.json              text eol=lf
Assets/**/*.cs               text eol=lf diff=csharp
Assets/**/*.uxml             text eol=lf
Assets/**/*.uss              text eol=lf
Assets/**/*.shader           text eol=lf
Assets/**/*.hlsl             text eol=lf
Assets/**/*.shadergraph      text eol=lf
Assets/**/*.asmdef           text eol=lf

# ── Große Terrain-Daten (Heights als Binärblock im .asset)
Assets/_Project/Data/Terrain/*.asset filter=lfs diff=lfs merge=lfs -text

